extends: default

rules:
  line-length: disable
  document-start: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: consistent

ignore: |
  .github/
  platform/*/manifests/
  # SOPS rewrites encrypted files with its own indentation (4-space) and
  # inserts ciphertext blobs where structured YAML would go. Linting them
  # is meaningless — CI already enforces they're encrypted via the
  # "sops:" grep check in validate.yml.
  **/*.enc.yaml
